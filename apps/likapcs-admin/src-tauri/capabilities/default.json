{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities of the LIKApcs Admin windows (main + the customer display)",
  "windows": ["main", "display"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "process:default",
    "updater:default",
    "autostart:default"
  ]
}
