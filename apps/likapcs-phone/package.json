{
  "name": "@likapcs/phone",
  "version": "0.27.4",
  "private": true,
  "description": "LIKApcs Phone: PWA for the owner and staff on a phone (over Tailscale)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:native": "tsc --noEmit && vite build --mode capacitor",
    "cap:sync": "npm run build:native && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7",
    "@capacitor/core": "^7",
    "@capacitor/local-notifications": "^7",
    "@likapcs/shared": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "@zxing/library": "0.21.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  }
}
