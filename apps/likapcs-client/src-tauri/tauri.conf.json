{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIKApcs-Client",
  "version": "../package.json",
  "identifier": "com.likapcs.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LIKApcs Client",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "transparent": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http://*:* https://*:* ws://*:* wss://*:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMUE1REIwRURBQzAzNDIKUldSQ0E2enRzRjBhelQ5TktXb1liWGlYUFpaZy9ZQXZxZitYclN1OGNscnE1UW1EcWZJanVLMi8K",
      "endpoints": [
        "https://raw.githubusercontent.com/astlika/LIKApcs/release-feed/latest-client.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
