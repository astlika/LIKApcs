{
  "name": "@likapcs/server",
  "version": "0.2.0",
  "private": true,
  "description": "LIKApcs Server — local authoritative backend (database, auth, billing, sessions, realtime)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "likapcs-server": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/cli.ts migrate",
    "migrate:status": "tsx src/cli.ts migrate:status",
    "create-admin": "tsx src/cli.ts create-admin"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/websocket": "^11.0.1",
    "@likapcs/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^6",
    "tar": "^7",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
