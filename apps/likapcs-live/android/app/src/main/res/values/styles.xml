<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar: the page draws its own top bar. The system bars take the page's colours,
         so on the tall 20:9 screen the app reads as one surface from the notch to the bottom. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
