{
  "name": "likapcs",
  "version": "0.5.1",
  "private": true,
  "description": "LIKApcs — Professional Gaming Station POS/ERP ecosystem (Admin, Client, Server)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @likapcs/server run migrate",
    "db:status": "pnpm --filter @likapcs/server run migrate:status",
    "dev:server": "pnpm --filter @likapcs/server run dev",
    "dev:admin": "pnpm --filter @likapcs/admin run dev",
    "server:create-admin": "pnpm --filter @likapcs/server run create-admin",
    "release:bump": "node scripts/bump-version.mjs",
    "secret:scan": "bash scripts/secret-scan.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
