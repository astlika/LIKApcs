# ─── LIKApcs Server configuration ───────────────────────────────────────────────
# Copy this file to apps/likapcs-server/.env (never commit the real .env).

# PostgreSQL connection string. The server is the ONLY component that talks to the database.
LIKAPCS_DATABASE_URL=postgres://likapcs:change-me@127.0.0.1:5432/likapcs

# Network binding. Use 0.0.0.0 to accept LAN connections from Admin and Client PCs.
LIKAPCS_HOST=0.0.0.0
LIKAPCS_PORT=4700

# Apply pending database migrations automatically on startup (true/false).
# Production recommendation: true, combined with the automatic pre-migration backup (Phase 6).
LIKAPCS_AUTO_MIGRATE=true

# Logging: trace | debug | info | warn | error
LIKAPCS_LOG_LEVEL=info

# Allowed browser origins for the Admin web build (comma separated). Tauri uses tauri://localhost.
LIKAPCS_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# Optional TLS for the HTTP/WebSocket listener (recommended on untrusted LANs).
# LIKAPCS_TLS_CERT_FILE=C:\ProgramData\LIKApcs\tls\server.crt
# LIKAPCS_TLS_KEY_FILE=C:\ProgramData\LIKApcs\tls\server.key

# Session lifetime for Admin logins, in hours.
LIKAPCS_SESSION_HOURS=12

# Where backups are written (must be OUTSIDE the installation directory).
LIKAPCS_BACKUP_DIR=C:\ProgramData\LIKApcs\backups
